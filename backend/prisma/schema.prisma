// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Watcher {
  id          Int      @id @default(autoincrement())
  fly_from    String
  fly_to      String
  date_from   String
  date_to     String?
  curr        String   @default("TWD")
  targetPrice Int
  emailUser      String
  lastPrice     Int?
  lastCheckedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model FlightResult {
  id          Int      @id @default(autoincrement())
  watcherId   Int
  price       Int
  origin      String
  destination String
  date        String
  airline     String?
  deepLink    String
  createdAt   DateTime @default(now())
}
